{
  "name": "sentinel",
  "version": "1.0.0",
  "description": "Uptime monitoring service with scheduled checks, incident detection, and alerting",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"node src/server.js\" \"node src/workers/scheduler.js\" \"node src/workers/checker.js\"",
    "dev:api": "nodemon src/server.js",
    "dev:scheduler": "nodemon src/workers/scheduler.js",
    "dev:checker": "nodemon src/workers/checker.js",
    "migrate:up": "node -r ./src/config/env.js ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir src/db/migrations",
    "migrate:down": "node -r ./src/config/env.js ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down --migrations-dir src/db/migrations",
    "migrate:create": "node -r ./src/config/env.js ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create --migrations-dir src/db/migrations",
    "test": "jest --runInBand --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint src tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suganth46/Sentinel.git"
  },
  "keywords": [
    "uptime",
    "monitoring",
    "alerts",
    "incidents"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.0.0",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "ipaddr.js": "^2.2.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.5.0",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "swagger-ui-express": "^5.0.1",
    "undici": "^6.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000
  }
}
