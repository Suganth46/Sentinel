# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://sentinel:sentinel@localhost:5432/sentinel
# node-pg-migrate reads this automatically

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_EXPIRES_IN=1h

# ─── Email (Nodemailer) ───────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM="Sentinel <no-reply@sentinel.example.com>"

# ─── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ─── Limits ───────────────────────────────────────────────────
MAX_MONITORS_PER_USER=20
CHECKER_CONCURRENCY=20
SCHEDULER_TICK_MS=15000
RETENTION_DAYS=30
